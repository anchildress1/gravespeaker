parse(json), raw, inTok: body.prompt_eval_count, outTok: body.eval_count };\n  } catch {\n    return { ms, error: \"unparseable JSON\", raw };\n  }\n}\n\n'''+s[old_end:]\ns=s.replace(\"for (const f of manifest) {\",\"for (const f of manifest.filter((f) => f.file !== \\\"holmquist-2024.jpg\\\")) {\")\nopen(sys.argv[2],\"w\").write(s)\nPY\ncd /Users/anchildress1/git_personal/gravespeaker && MODELS=gemma4:12b node $B/run-local.mjs \"$PWD/fixtures\" $B/results-local-12b.json 2>&1 | grep -v '^\\s*$'","description":"Run the same OCR test against local Gemma 4 12B","timeout":600000},"caller":{"type":"direct"}}]}}
