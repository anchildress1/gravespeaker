{"parentUuid":null,"logicalParentUuid":"94c62dbf-24f7-4401-b3c9-e76f73839b8f","isSidechain":false,"type":"system","subtype":"compact_boundary","content":"Conversation compacted","level":"info","compactMetadata":{"trigger":"auto","preTokens":367260,"postTokens":41617,"cumulativeDroppedTokens":325643,"durationMs":95223,"preCompactDiscoveredTools":["ArtifactData","WebFetch","WebSearch"],"preCompactArtifactReadVersions":[{"slug":"0fe6a940-37af-4fe7-adf1-21afb64230b4","ver":"1793121521-4106"}],"preservedSegment":{"headUuid":"13b834f3-d8cb-4d00-9580-69969915b87f","anchorUuid":"a1d974e4-375e-47f8-a628-70b828bf9c80","tailUuid":"94c62dbf-24f7-4401-b3c9-e76f73839b8f"},"preservedMessages":{"anchorUuid":"a1d974e4-375e-47f8-a628-70b828bf9c80","uuids":["13b834f3-d8cb-4d00-9580-69969915b87f","6aac5ffb-6861-4606-8a7a-1b534c57cdc3","8bb98e94-f264-42c0-99c2-cdd99eb53430","98c3e923-0dc2-45c3-97f4-91299db646ff","aae394af-fe01-4846-837f-beddd14f3513","20d4235a-ca9e-48ec-8a45-7bb3bc03b2e0","369194be-217c-43e7-9a49-26d6e8d6a3b2","4c7f36d3-2e2c-4676-9f5c-232cc0247966","2b9183f6-e14c-411f-9926-7d1e0f6407bc","61c66c96-9997-44c6-bfb4-e81c625576b7","18c24a8d-5800-4b4d-b89b-42072d17c455","94c62dbf-24f7-4401-b3c9-e76f73839b8f"],"allUuids":["13b834f3-d8cb-4d00-9580-69969915b87f","6aac5ffb-6861-4606-8a7a-1b534c57cdc3","8bb98e94-f264-42c0-99c2-cdd99eb53430","98c3e923-0dc2-45c3-97f4-91299db646ff","aae394af-fe01-4846-837f-beddd14f3513","20d4235a-ca9e-48ec-8a45-7bb3bc03b2e0","369194be-217c-43e7-9a49-26d6e8d6a3b2","d86d6d71-f336-4d98-a23d-37be09698182","4c7f36d3-2e2c-4676-9f5c-232cc0247966","2b9183f6-e14c-411f-9926-7d1e0f6407bc","61c66c96-9997-44c6-bfb4-e81c625576b7","18c24a8d-5800-4b4d-b89b-42072d17c455","94c62dbf-24f7-4401-b3c9-e76f73839b8f"]}},"uuid":"a86f3c5c-b462-4927-8512-1da43de338d7","timestamp":"2026-10-27T18:21:38.069Z","userType":"external","entrypoint":"cli","cwd":"/Users/anchildress1/git_personal/gravespeaker","sessionId":"a78fbb29-c412-483a-b679-0722adb27f13","version":"2.1.311","gitBranc