{
	"name": "gravespeaker",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"node": "26.12.1"
	},
	"packageManager": "pnpm@11.28.9",
	"volta": {
		"node": "26.12.1",
		"pnpm": "11.28.9"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && lefthook install || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "eslint . --max-warnings 0",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run --coverage --passWithNoTests",
		"test:e2e": "playwright test --pass-with-no-tests"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-node": "6.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "26.6.5",
		"@vitest/coverage-v8": "5.0.5",
		"commitlint-plugin-rai": "1.0.3",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-jsdoc": "65.4.2",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"lefthook": "2.2.2",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"vite": "8.3.5",
		"vitest": "5.0.5",
		"web-vitals": "6.2.3"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@elevenlabs/elevenlabs-js": "2.75.0",
		"@mastra/core": "1.79.0",
		"@mozilla/readability": "0.6.0",
		"exifreader": "4.52.0",
		"linkedom": "0.18.14",
		"robots-parser": "3.0.1",
		"undici": "8.12.3",
		"zod": "4.6.7"
	}
}
